(* FLOAT_HIGH *)
PROGRAM main
  VAR_OUTPUT
    PUMP AT %QX0.0 : BOOL;
    FAULT AT %QX0.1 : BOOL;
  END_VAR
  VAR
    FLOAT_HIGH AT %MX0.0 : BOOL;
    FLOAT_LOW AT %MX0.1 : BOOL;
    ESTOP AT %MX0.2 : BOOL;
    PUMP_LATCH : BOOL;
  END_VAR
  PUMP_LATCH := (FLOAT_LOW OR PUMP_LATCH) AND NOT FLOAT_HIGH AND NOT ESTOP;
  PUMP := PUMP_LATCH;
  FAULT := FLOAT_HIGH AND FLOAT_LOW;
END_PROGRAM

CONFIGURATION Config0
  RESOURCE Res0 ON PLC
    TASK task0 (INTERVAL := T#20ms, PRIORITY := 0);
    PROGRAM instance0 WITH task0 : main;
  END_RESOURCE
END_CONFIGURATION